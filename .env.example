# Optional keys. Copy this file to .env and fill in only what you use.
# .env is git-ignored; never paste keys in chat.

# Music search (recommended, free): https://devportal.jamendo.com -> sign up -> create an app -> Client ID.
# Without it, music is searched on Openverse (no key needed, smaller selection).
# JAMENDO_CLIENT_ID=

# API mode (optional, later): https://platform.claude.com -> API Keys
# ANTHROPIC_API_KEY=

# Gemini watcher critic (optional, decided in Phase 4): https://aistudio.google.com -> Get API key
# GEMINI_API_KEY=
